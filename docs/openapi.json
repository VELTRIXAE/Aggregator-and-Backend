    "/api/v1/swaps/prepare": {
      "post": {
        "summary": "Simulate a fresh swap and return unsigned wallet XDR; never submits",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote": {
                    "type": "object",
                    "properties": {
                      "tokenIn": {
                        "type": "string"
                      },
                      "tokenOut": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,38}$"
                      },
                      "kind": {
                        "default": "exactIn",
                        "type": "string",
                        "enum": [
                          "exactIn",
                          "exactOut"
                        ]
                      },
                      "slippageBps": {
                        "default": 50,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      "maxHops": {
                        "default": 3,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      }
                    },
                    "required": [
                      "tokenIn",
                      "tokenOut",
                      "amount"
                    ],
                    "additionalProperties": false
                  },
                  "publicKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "quote",
                  "publicKey"
                ],
                "additionalProperties": false
              }
            }
          }
