{
  "name": "veltrixae-aggregator",
  "version": "0.1.0",
  "private": true,
  "description": "VELTRIXAE is a decentralized liquidity aggregation and trading infrastructure built on Stellar.",
  "workspaces": [
    "api",
    "packages/frontend-client"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "dev": "npm run dev --workspace api",
    "start": "npm start --workspace api",
    "test:rpc": "npm run test:rpc --workspace api",
    "verify:deployment": "npm run verify --workspace api",
    "test:contracts": "bash scripts/test-contracts.sh",
    "check:upstream": "node --import tsx api/src/check-upstream.ts",
    "docs:api": "node --import tsx api/src/export-openapi.ts",
    "test:abi": "node --import tsx --test api/test/contract-abi.contract.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
