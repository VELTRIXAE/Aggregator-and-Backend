# No wallet secrets are accepted by the API.
PORT=3000
HOST=127.0.0.1
RPC_URL=https://soroban-testnet.stellar.org
DEPLOYMENTS_FILE=config/testnet.json
CORS_ORIGINS=http://localhost:5173
# Exact proxy IPs or CIDR ranges allowed to set X-Forwarded-For. Leave empty unless behind a known proxy.
TRUSTED_PROXIES=
RPC_TIMEOUT_MS=10000
# Opt-in live integration tests, after verifying the configured deployment:
RUN_TESTNET_TESTS=0

# Global transport concurrency (1–10), queue capacity is 64.
RPC_CONCURRENCY=5
# Complete discovery only: exceeding the cap or time budget fails, never returns a partial quote universe.
MAX_DISCOVERY_POOLS=1000
DISCOVERY_PAGE_SIZE=5
DISCOVERY_TIMEOUT_MS=15000
# Optional live quote parity case: real funded pool/token contracts only.
# TEST_TOKEN_IN=
# TEST_TOKEN_OUT=
# TEST_AMOUNT=10000
